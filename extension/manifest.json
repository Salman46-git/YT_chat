
{
  "manifest_version": 3,
  "name": "YT RAG Chat",
  "version": "1.0.0",
  "description": "AI-powered chat with YouTube videos using RAG",

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "marked.min.js",
        "purify.min.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
